{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuzzfw.dev/schemas/build_info.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "fuzzfw build_info.json",
  "type": "object",
  "required": ["schema_version", "created_at", "build_manifest_sha256", "analysis_sha256", "plan_id", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string"},
    "build_manifest_sha256": {"type": "string"},
    "analysis_sha256": {"type": "string"},
    "config_fingerprint": {"type": "string"},
    "plan_id": {"type": "string"},
    "toolchain_hash": {"type": "string"},
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "result"],
        "properties": {
          "name": {"type": "string"},
          "result": {"type": "object"}
        }
      }
    },
    "generated_at": {"type": "string"},
    "toolchain": {"type": "object"},
    "plan": {"type": "object"}
  }
}
